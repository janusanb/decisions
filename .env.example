# Bind address. Use 0.0.0.0 so other devices on the LAN can connect.
HOST=0.0.0.0
PORT=3000

# SQLite file. In Docker this should stay on the mounted /data volume.
DATABASE_PATH=./data/decisions.db

# A restaurant is "due" when it has no confirmed visit within this many days.
DUE_AFTER_DAYS=21

# Directory of compiled client assets. Defaults to dist/client after `npm run build`.
# CLIENT_DIR=./dist/client

# Directory of SQL migrations. Defaults to next to the server entry file.
# MIGRATIONS_DIR=./server/src/migrations

LOG_LEVEL=info

# Shown in the UI as the URL other phones should open. Not 127.0.0.1.
# ADVERTISE_HOST=10.0.0.181
